# SERVER & NETWORK
NODE_ENV=production
PORT=4000
API_URL=http://localhost:4000
FRONTEND_URL=http://localhost:3000

# DATABASE (PostgreSQL)
# For local dev / VPS:
DATABASE_URL="postgresql://typhoon_user:TyphoonSecure2026!@localhost:5432/typhoon_solar?schema=public"

# REDIS (Optional for local, or on VPS)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# AUTH & SECURITY (Generate 64+ char random strings)
JWT_ACCESS_SECRET=ChangeThisToAStrong64CharRandomJwtAccessSecretKeyForTyphoonSolar2026!
JWT_REFRESH_SECRET=ChangeThisToAStrong64CharRandomJwtRefreshSecretKeyForTyphoonSolar2026!
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=30d
HMAC_CUSTOMER_LINK_SECRET=ChangeThisToRandomHmacSecretForPublicCustomerLinks2026!

# FILE STORAGE
UPLOAD_BASE_PATH=./uploads
MAX_FILE_SIZE_MB=15

# FIREBASE CLOUD MESSAGING (Optional - for push notifications)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
